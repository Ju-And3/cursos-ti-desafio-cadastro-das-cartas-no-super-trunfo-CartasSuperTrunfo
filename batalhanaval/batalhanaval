#include <stdio.h>

int main() {
    // Definindo o tamanho do tabuleiro
    const int TAMANHO = 10;
    
    // Representando o tabuleiro como uma matriz 10x10
    int tabuleiro[TAMANHO][TAMANHO];
    
    // Inicializando o tabuleiro com 0 (água)
    for (int i = 0; i < TAMANHO; i++) {
        for (int j = 0; j < TAMANHO; j++) {
            tabuleiro[i][j] = 0;
        }
    }
    
    // Definindo os navios como vetores unidimensionais
    int navioHorizontal[3] = {3, 3, 3};
    int navioVertical[3] = {3, 3, 3};
    
    // Posicionando o navio horizontal (linha 0, colunas 0-2)
    int linhaH = 0;
    int colunaH = 0;
    for (int k = 0; k < 3; k++) {
        tabuleiro[linhaH][colunaH + k] = navioHorizontal[k];
    }
    
    // Posicionando o navio vertical (linha 2, coluna 5, linhas 2-4)
    int linhaV = 2;
    int colunaV = 5;
    for (int k = 0; k < 3; k++) {
        tabuleiro[linhaV + k][colunaV] = navioVertical[k];
    }
    
    // Exibindo o tabuleiro
    printf("Tabuleiro do Batalha Naval:\n");
    for (int i = 0; i < TAMANHO; i++) {
        for (int j = 0; j < TAMANHO; j++) {
            printf("%d ", tabuleiro[i][j]);
        }
        printf("\n");
    }
    
    return 0;
}
